# Example environment variables file
# Copy this to .env and fill in your actual values

# Database
# Local development example:
DATABASE_URL="postgresql://username:password@localhost:5432/opus_authoring"
#
# Vercel / hosted Postgres:
# Use your provider's pooled or serverless-compatible Postgres URL.
# If the database is remote, this app will enable SSL automatically.

# AI Services
GEMINI_API_KEY="your_gemini_api_key_here"
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
TAVUS_API_KEY="your_tavus_api_key_here"
TAVUS_REPLICA_ID="your_tavus_replica_id_here"
# Optional: path to a PEM/CRT bundle to trust if your network uses SSL inspection
# TAVUS_CA_CERT_PATH="C:\\path\\to\\corporate-root-ca.pem"
# Optional: disable TLS verification for Tavus requests only. Local debugging only.
# TAVUS_ALLOW_INSECURE_TLS="false"
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="your_elevenlabs_voice_id_here"
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"

# Legacy (no longer used)
# OPENAI_API_KEY="your_openai_api_key_here"

# Other services (if applicable)
# Add other environment variables your application needs
